{
  "name": "jungle-esports",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assets": "tsx scripts/build-assets.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "build": "npm run assets && npm run sprites && npm run model-sheet && npm run check && vite build && tsx scripts/build-offline.ts && tsx scripts/check-budget.ts",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src scripts tests *.ts *.js *.json README.md",
    "model-sheet": "tsx scripts/model-sheet.ts",
    "art:v2": "tsx scripts/create-v2-art.ts",
    "assets:3d": "tsx scripts/build-3d.ts",
    "check:3d": "tsx scripts/check-3d.ts",
    "sprites": "tsx scripts/build-sprites.ts && tsx scripts/build-challenge-sprites.ts && tsx scripts/build-polish-assets.ts"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.22.0",
    "svelte": "^5.57.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "free-tex-packer-core": "^0.3.9",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
